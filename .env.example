# Sample environment variables for non-interactive smoke runs.
# Copy to `.env` and fill in real credentials locally (do NOT commit secrets).

# Required for first non-interactive login if no valid cookie/session exists.
DOMINIONSC_TEST_USERNAME=your_username_here
DOMINIONSC_TEST_PASSWORD=your_password_here

# Optional fallback names supported by the script.
# DOMINION_USERNAME=your_username_here
# DOMINION_PASSWORD=your_password_here

# Optional run behavior (defaults shown).
DOMINIONSC_TEST_POLL_MINUTES=15
DOMINIONSC_TEST_DAILY_LOOKBACK_DAYS=5
# Number of previous completed billing cycles to backfill.
DOMINIONSC_TEST_BACKFILL_CYCLES_TARGET=6

# Cookie/session persistence path.
DOMINIONSC_TEST_COOKIE_PATH=dominion_cookies.json

# Networking/debug flags.
DOMINIONSC_TEST_VERIFY_SSL=false
DOMINIONSC_TEST_LOG_REQUESTS=false
